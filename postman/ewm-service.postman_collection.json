              "mode": "raw",
              "raw": "{\"name\":\"Иван Петров\",\"email\":\"ivan.petrov@practicummail.ru\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Статус 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('Есть id', () => pm.expect(body.id).to.be.a('number'));",
